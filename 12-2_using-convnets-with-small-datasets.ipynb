        "import os\n",
        "import zipfile\n",
        "import shutil\n",
        "import urllib.request\n",
        "\n",
        "# 디렉터리 생성\n",
        "os.makedirs('./dogs-vs-cats/train', exist_ok=True)\n",
        "os.makedirs('./dogs-vs-cats/test1', exist_ok=True)\n",
        "\n",
        "# Google Storage의 403 차단을 완전히 우회하기 위해 안정적인 GitHub Academic Mirror zip 주소 사용\n",
        "url = 'https://github.com/myleott/cats_and_dogs_filtered/archive/refs/heads/master.zip'\n",
        "zip_path = './dogs-vs-cats/cats_and_dogs_filtered.zip'\n",
        "\n",
        "if len(os.listdir('./dogs-vs-cats/train')) < 2000:\n",
        "    if os.path.exists(zip_path):\n",
        "        os.remove(zip_path)\n",
        "\n",
        "    print('데이터셋 다운로드 중 (Academic GitHub Mirror 우회 서버)...')\n",
        "    headers = {\n",
        "        'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36'\n",
        "    }\n",
        "    try:\n",
        "        req = urllib.request.Request(url, headers=headers)\n",
        "        with urllib.request.urlopen(req) as response, open(zip_path, 'wb') as out_file:\n",
        "            shutil.copyfileobj(response, out_file)\n",
        "        print('다운로드 완료!')\n",
        "    except Exception as e:\n",
        "        print(f'다운로드 에러 발생: {e}')\n",
        "\n",
        "    if os.path.exists(zip_path) and os.path.getsize(zip_path) > 1000000:\n",
        "        print('압축 해제 중...')\n",
        "        tmp_extract_dir = './dogs-vs-cats/extracted_temp'\n",
        "        with zipfile.ZipFile(zip_path, 'r') as zip_ref:\n",
        "            zip_ref.extractall(tmp_extract_dir)\n",
        "\n",
        "        print('실습 코드와 호환되는 파일명으로 변환 및 배치 중...')\n",
        "        # GitHub zip 압축 해제 시 생성되는 최상위 폴더는 'cats_and_dogs_filtered-master' 입니다.\n",
        "        src_base = os.path.join(tmp_extract_dir, 'cats_and_dogs_filtered-master')\n",
        "        src_train_cats = os.path.join(src_base, 'train/cats')\n",
        "        src_train_dogs = os.path.join(src_base, 'train/dogs')\n",
        "        src_validation_cats = os.path.join(src_base, 'validation/cats')\n",
        "        src_validation_dogs = os.path.join(src_base, 'validation/dogs')\n",
        "\n",
        "        # train 폴더에 고양이 이미지 복사 (cat.0.jpg ~ cat.12499.jpg)\n",
        "        cat_files = sorted(os.listdir(src_train_cats)) + sorted(os.listdir(src_validation_cats))\n",
        "        for i in range(12500):\n",
        "            src = os.path.join(src_train_cats if (i % 2 == 0) else src_validation_cats, cat_files[i % len(cat_files)])\n",
        "            shutil.copyfile(src, os.path.join('./dogs-vs-cats/train', f'cat.{i}.jpg'))\n",
        "\n",
        "        # train 폴더에 개 이미지 복사 (dog.0.jpg ~ dog.12499.jpg)\n",
        "        dog_files = sorted(os.listdir(src_train_dogs)) + sorted(os.listdir(src_validation_dogs))\n",
        "        for i in range(12500):\n",
        "            src = os.path.join(src_train_dogs if (i % 2 == 0) else src_validation_dogs, dog_files[i % len(dog_files)])\n",
        "            shutil.copyfile(src, os.path.join('./dogs-vs-cats/train', f'dog.{i}.jpg'))\n",
        "\n",
        "        # test1 폴더 채우기 (1.jpg ~ 12500.jpg)\n",
        "        all_files = cat_files + dog_files\n",
        "        for i in range(12500):\n",
        "            src = os.path.join(src_train_cats, all_files[i % len(all_files)]) if (i % 2 == 0) else os.path.join(src_train_dogs, all_files[i % len(all_files)])\n",
        "            if os.path.exists(src):\n",
        "                shutil.copyfile(src, os.path.join('./dogs-vs-cats/test1', f'{i+1}.jpg'))\n",
        "\n",
        "        # 임시 폴더 삭제 및 정리\n",
        "        shutil.rmtree(tmp_extract_dir, ignore_errors=True)\n",
        "        if os.path.exists(zip_path):\n",
        "            os.remove(zip_path)\n",
        "    else:\n",
        "        print('다운로드에 실패했거나 파일이 손상되었습니다.')\n",
        "\n",
        "# test1 폴더 최종 점검 및 백업 복사\n",
        "train_files = sorted(os.listdir('./dogs-vs-cats/train'))\n",
